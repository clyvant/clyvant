          "at": "start",
          "name": "whoosh2",
          "gain": -8
        }
      ]
    },
    {
      "id": "t2",
      "vo": "Researchers asked homeowners to put a huge, ugly Drive Carefully sign on their lawn. Only seventeen percent said yes.",
